OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
DATABASE_PATH=data/sivraj.db
CONVERSATION_TEMPERATURE=0.8
EXTRACTION_TEMPERATURE=0.2

WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_BACKEND=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=models/piper/ml_IN-arjun-medium.onnx
# macOS development fallback: set TTS_BACKEND=say and optionally a voice.
MACOS_VOICE=

MIC_DEVICE=
SPEAKER_DEVICE=
HISTORY_TURNS=16
DEBUG=true

# Visual HUD presence detection (starts only after Enter) and camera test
CAMERA_INDEX=0
CAMERA_PREVIEW=true
CAMERA_FRAME_WIDTH=640
PRESENCE_CONFIRM_FRAMES=2
PRESENCE_ABSENCE_THRESHOLD=5.0
PRESENCE_TARGET_FPS=12
FACE_SCALE_FACTOR=1.1
FACE_MIN_NEIGHBORS=5
FACE_MIN_SIZE=60

# Optional override for the Electron executable used by absence mode.
SIVRAJ_BROWSER_COMMAND=
