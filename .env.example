OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
DATABASE_PATH=data/sivraj.db
CONVERSATION_TEMPERATURE=0.8
EXTRACTION_TEMPERATURE=0.2

WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

TTS_BACKEND=piper
PIPER_EXECUTABLE=piper
PIPER_MODEL_PATH=models/piper/ml_IN-arjun-medium.onnx
# macOS development fallback: set TTS_BACKEND=say and optionally a voice.
MACOS_VOICE=

MIC_DEVICE=
SPEAKER_DEVICE=
HISTORY_TURNS=16
DEBUG=true
